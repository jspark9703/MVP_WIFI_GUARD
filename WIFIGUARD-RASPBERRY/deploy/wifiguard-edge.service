# /etc/systemd/system/wifiguard-edge.service
#
#   sudo cp deploy/wifiguard-edge.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now wifiguard-edge
#
# 설치 스크립트가 User/Group/WorkingDirectory를 실제 설치값으로 치환한다.

[Unit]
Description=WIFI-GUARD Edge (CSI 수집 · 재실감지 · 피처 추출 · MQTT 업링크)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pi
Group=pi
SupplementaryGroups=gpio spi
WorkingDirectory=/opt/wifiguard-edge
Environment=PYTHONPATH=/opt/wifiguard-edge/src
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/wifiguard-edge/.venv/bin/python -m wifiguard_edge

# 24시간 상시 운용 (명세 §4 Phase 5-2)
Restart=always
RestartSec=5
# 워치독: 애플리케이션이 sd_notify(WATCHDOG=1)를 주기적으로 보내야 한다 (health.py 미구현)
# WatchdogSec=60

# SD카드 마모 완화 — 로그는 저널로만, 파일로 남기지 않는다
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target

{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Ec2InSeoulOnly",
      "Effect": "Allow",
      "Action": "ec2:*",
      "Resource": "*",
      "Condition": { "StringEquals": { "aws:RequestedRegion": "ap-northeast-2" } }
    },
    {
      "Sid": "SsmParamsAndSessions",
      "Effect": "Allow",
      "Action": [
        "ssm:PutParameter", "ssm:GetParameter", "ssm:GetParameters", "ssm:GetParametersByPath",
        "ssm:DeleteParameter", "ssm:DeleteParameters", "ssm:DescribeParameters",
        "ssm:StartSession", "ssm:TerminateSession", "ssm:DescribeInstanceInformation"
      ],
      "Resource": "*"
    },
    {
      "Sid": "PassInstanceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::*:role/wifiguard-ec2-role"
    }
  ]
}

# cp compose/.env.example compose/.env
# 실제 .env 는 절대 커밋하지 않는다.

# 로컬 호스트의 MQTT 포트. 다른 Mosquitto가 1883을 쓰면 1884 등으로 바꾼다.
MQTT_HOST_PORT=1883
PG_HOST_PORT=5432
TSDB_HOST_PORT=5433
API_HOST_PORT=8000

# ── PostgreSQL (관계형: 계정·시설·기기·거주자·이벤트 이력) ──
PG_NAME=wifiguard
PG_USER=wifiguard
PG_PASSWORD=changeme

# ── TimescaleDB (고빈도 시계열: 재실/움직임 지표, 피처 통계) ──
TSDB_NAME=wifiguard_ts
TSDB_USER=wifiguard
TSDB_PASSWORD=changeme

# ── 오브젝트 스토리지 (개발: MinIO / 운영: S3·GCS) ──
MINIO_USER=minioadmin
MINIO_PASSWORD=changeme

# ── 관측 ──
GRAFANA_PASSWORD=changeme

# ── 서비스 API (packages/db · services/api) ──
# SQLAlchemy 접속 문자열. 미설정 시 PG_DSN → 로컬 드라이런 wg-pg 기본값 순으로 사용.
DATABASE_URL=postgresql+psycopg://wifiguard:devpass@127.0.0.1:5432/wifiguard
# pytest 전용 DB (make test). 없으면 conftest 가 생성한다.
DATABASE_URL_TEST=postgresql+psycopg://wifiguard:devpass@127.0.0.1:5432/wifiguard_test
# 브라우저 오리진 허용 정규식 (기본: localhost/127.0.0.1 임의 포트)
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$
# POST /api/v1/falls/simulate 노출 여부 (개발 1 / 운영 0)
ALLOW_FALL_SIMULATE=1

# ── 인증 ──
# 최소 32바이트. 운영에서는 secret manager가 만든 무작위 값을 사용한다.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=14

# ── 낙상 추론 ──
# 실제 파일은 저장소에 포함하지 않는다. 호스트 경로를 read-only로 마운트한다.
MODEL_CHECKPOINT_HOST=../weights/temporal_segmentation_fixed_delay.pt
MODEL_DEVICE=cpu
# 비우면 체크포인트에 저장된 threshold를 사용한다.
MODEL_THRESHOLD=
MODEL_POSTPROCESS=b
INFERENCE_BATCH_SIZE=4
INFERENCE_BATCH_WAIT_MS=300
MLFLOW_TRACKING_URI=http://mlflow:5000
SEGMENTATION_PACKAGE_ROOT=

# ── 알림 ──
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=alerts@wifiguard.local
SMTP_STARTTLS=0
MAILPIT_UI_PORT=8025
SMS_PROVIDER=            # nhn-toast | aligo | twilio (미정 — 명세 §4-3)
SMS_API_KEY=
SMS_SENDER=

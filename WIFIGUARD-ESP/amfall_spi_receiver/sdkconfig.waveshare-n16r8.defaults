# Reviewed hardware overlay for the Waveshare/SpotPear
# ESP32-C5-WIFI6-KIT-N16R8 receiver board.
#
# Source schematic:
# https://files.waveshare.com/wiki/ESP32-C5-WIFI6-KIT-NXRX/ESP32-C5-WIFI6-KIT-NXRX-Schematic.pdf
#
# Apply after sdkconfig.defaults. This overlay contains no Wi-Fi credentials.
# GPIO6 is not used because the carrier routes it to BAT_ADC. GPIO11/12 are
# reserved for CH343 UART, GPIO13/14 for native USB, GPIO27 for the RGB LED,
# and boot/JTAG strapping pins are avoided.
CONFIG_WIFI_GUARD_BOARD_PINS_APPROVED=y
CONFIG_WIFI_GUARD_SPI_SCLK_GPIO=8
CONFIG_WIFI_GUARD_SPI_MOSI_GPIO=9
CONFIG_WIFI_GUARD_SPI_MISO_GPIO=10
CONFIG_WIFI_GUARD_SPI_CS_GPIO=23
CONFIG_WIFI_GUARD_SPI_READY_GPIO=24
CONFIG_WIFI_GUARD_SPI_MODE=0
CONFIG_WIFI_GUARD_SPI_READY_ACTIVE_HIGH=y
CONFIG_WIFI_GUARD_SPI_BATCH_FRAMES=8
CONFIG_WIFI_GUARD_MAX_QUEUE=16

# The SPI receiver no longer streams binary CSI over USB. Keep an INFO-level
# maintenance console on UART0 (GPIO11/12 through the on-board CH343 bridge)
# so field validation can distinguish Wi-Fi, CSI, and SPI startup failures.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# CONFIG_ESP_CONSOLE_NONE is not set
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
# CONFIG_ESP_CONSOLE_UART_CUSTOM is not set
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# CONFIG_LOG_DEFAULT_LEVEL_NONE is not set
CONFIG_LOG_DEFAULT_LEVEL=3

# The installed N16R8 module and both esptool probes identify 16 MB flash.
# PSRAM is not required by this receiver and is deliberately not enabled here.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

CONFIG_ESP_WIFI_CSI_ENABLED=y

# Keep diagnostics on UART0. The SPI data plane never shares the console.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

CONFIG_WIFI_GUARD_WIFI_SSID=""
CONFIG_WIFI_GUARD_WIFI_PASSWORD=""
CONFIG_WIFI_GUARD_WIFI_BAND_5G_ONLY=y
CONFIG_WIFI_GUARD_EXPECTED_CHANNEL=48
CONFIG_WIFI_GUARD_UDP_PORT=3333
CONFIG_WIFI_GUARD_MAX_QUEUE=64
CONFIG_WIFI_GUARD_FILTER_AP_BSSID=y
CONFIG_WIFI_GUARD_SPI_MODE=0
CONFIG_WIFI_GUARD_SPI_READY_ACTIVE_HIGH=y

# Deliberately incomplete. A reviewed board overlay must set the ESP32-C5 GPIOs
# and CONFIG_WIFI_GUARD_BOARD_PINS_APPROVED=y before a flashable build exists.
CONFIG_WIFI_GUARD_BOARD_PINS_APPROVED=n

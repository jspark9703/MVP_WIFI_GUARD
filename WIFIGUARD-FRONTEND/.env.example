# cp .env.example .env
# 읽는 곳: src/api/client.ts (VITE_API_BASE_URL), src/api/queries/* (VITE_USE_MOCK), src/lib/backend.ts (VITE_WS_URL),
#          src/components/AuthGate.tsx · src/routes/devices.tsx (VITE_ENABLE_LIVE). 타입 선언은 src/vite-env.d.ts.

# 서비스 API (WIFIGUARD-BACKEND: make api → http://127.0.0.1:8000/docs)
VITE_API_BASE_URL=http://127.0.0.1:8000

# 실시간 스트림 — 이번 단계 미구현. VITE_ENABLE_LIVE=1 일 때만 사용된다.
VITE_WS_URL=ws://127.0.0.1:8000/ws/live
VITE_ENABLE_LIVE=0

# 목업 시뮬레이션 스위치. 1 이면 mock-store 의 setInterval(tick, 100) 이 돌고 데이터 훅이 목업을 읽는다.
# 0 이면 실API(TanStack Query)만 사용하고 시뮬레이션 코드는 프로덕션 번들에서 제거된다.
VITE_USE_MOCK=0

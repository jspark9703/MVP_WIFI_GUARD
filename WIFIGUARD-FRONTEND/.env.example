# cp .env.example .env
# 읽는 곳: src/api/client.ts (VITE_API_BASE_URL) · src/api/realtime/socket.ts (VITE_WS_URL)
#          src/api/queries|mutations|auth (VITE_USE_MOCK). 타입 선언은 src/vite-env.d.ts.

# 서비스 API (WIFIGUARD-BACKEND: make api → http://127.0.0.1:8000/docs)
VITE_API_BASE_URL=http://127.0.0.1:8000

# 실시간 스트림. 비우면 위 주소에서 파생한다 (http→ws, 경로 /ws/live).
# 백엔드에 MQTT_HOST·KAFKA_BOOTSTRAP 이 설정돼 있어야 실제 데이터가 흐른다.
VITE_WS_URL=ws://127.0.0.1:8000/ws/live

# 목업 시뮬레이션 스위치. 1 이면 mock-store 의 setInterval(tick, 100) 이 돌고 데이터 훅이 목업을 읽는다.
# 0 이면 실API + 실시간 WS 만 사용하고 시뮬레이션 코드는 프로덕션 번들에서 제거된다.
VITE_USE_MOCK=0
